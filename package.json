{
  "name": "sorting-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint:style": "stylelint src/*/javascript/**/*.{css,scss,vue} --fix",
    "lint:script": "eslint --ext .ts,.vue --ignore-path .gitignore src/*/javascript --fix",
    "lint:prettier": "prettier --write \"src/*/javascript/**/*.{ts,js,vue}\"",
    "format": "npm run lint:style && npm run lint:prettier && npm run lint:script",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.13.6",
    "roboto-fontface": "^0.10.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0",
    "vuetify": "^3.6.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.4.4",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.14.5",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "sass": "^1.70.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "braces": "^3.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
